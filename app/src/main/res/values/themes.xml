<resources>
    <!-- Base application theme - Dark -->
    <style name="Theme.NikziGPT" parent="Theme.Material3.Dark.NoActionBar">
        <!-- Primary brand color -->
        <item name="colorPrimary">@color/nikzi_primary</item>
        <item name="colorPrimaryVariant">@color/nikzi_primary_variant</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color -->
        <item name="colorSecondary">@color/nikzi_secondary</item>
        <item name="colorSecondaryVariant">@color/nikzi_secondary</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- Background colors -->
        <item name="android:colorBackground">@color/nikzi_background</item>
        <item name="colorSurface">@color/nikzi_surface</item>
        <item name="colorOnSurface">@color/nikzi_text_primary</item>
        <!-- Status bar -->
        <item name="android:statusBarColor">@color/nikzi_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <!-- Navigation bar -->
        <item name="android:navigationBarColor">@color/nikzi_background</item>
        <item name="android:windowLightNavigationBar">false</item>
        <!-- Window -->
        <item name="android:windowBackground">@color/nikzi_background</item>
    </style>

    <!-- Light theme -->
    <style name="Theme.NikziGPT.Light" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/nikzi_primary</item>
        <item name="colorPrimaryVariant">@color/nikzi_primary_variant</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/nikzi_secondary</item>
        <item name="colorSecondaryVariant">@color/nikzi_secondary</item>
        <item name="colorOnSecondary">@color/black</item>
        <item name="android:colorBackground">@color/md_sys_color_background_light</item>
        <item name="colorSurface">@color/md_sys_color_surface_light</item>
        <item name="colorOnSurface">@color/md_sys_color_on_surface_light</item>
        <item name="android:statusBarColor">@color/md_sys_color_surface_light</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@color/md_sys_color_surface_light</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowBackground">@color/md_sys_color_background_light</item>
    </style>

    <!-- Splash theme -->
    <style name="Theme.NikziGPT.Splash" parent="Theme.NikziGPT">
        <item name="android:windowBackground">@drawable/splash_background</item>
        <item name="android:windowFullscreen">true</item>
    </style>
</resources>